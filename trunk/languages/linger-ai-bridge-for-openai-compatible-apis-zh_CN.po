#. Plugin Name of the plugin
#: linger-ai-bridge-for-openai-compatible-apis.php
#: src/Provider/ResponsesProvider.php:35 src/Settings/ResponsesSettings.php:73
#: src/Settings/ResponsesSettings.php:74
msgid "AI Bridge for OpenAI-Compatible APIs"
msgstr "AI Bridge for OpenAI-Compatible APIs"

#. Description of the plugin
#: linger-ai-bridge-for-openai-compatible-apis.php
msgid ""
"Connect WordPress AI to custom OpenAI-compatible APIs with Responses, Chat "
"Completions, a default model, and up to 10 models."
msgstr ""
"为 WordPress AI 接入自定义 OpenAI 兼容接口，支持 Responses、Chat Completions、默认模型及最多 10 "
"个模型。"

#. Author of the plugin
#: linger-ai-bridge-for-openai-compatible-apis.php
msgid "Linger0"
msgstr "Linger0"

#. Author URI of the plugin
#: linger-ai-bridge-for-openai-compatible-apis.php
msgid "https://github.com/Linger0"
msgstr "https://github.com/Linger0"

#. translators: 1: Minimum required PHP version, 2: Current PHP version.
#: linger-ai-bridge-for-openai-compatible-apis.php:51
#, php-format
msgid ""
"The AI Bridge for OpenAI-Compatible APIs plugin requires PHP version %1$s or"
" higher. You are running PHP version %2$s."
msgstr ""
"AI Bridge for OpenAI-Compatible APIs 插件需要 PHP %1$s 或更高版本。你当前使用的 PHP 版本为 "
"%2$s。"

#. translators: 1: Minimum required WordPress version, 2: Current WordPress
#. version.
#: linger-ai-bridge-for-openai-compatible-apis.php:74
#, php-format
msgid ""
"The AI Bridge for OpenAI-Compatible APIs plugin requires WordPress version "
"%1$s or higher. You are running WordPress version %2$s."
msgstr ""
"AI Bridge for OpenAI-Compatible APIs 插件需要 WordPress %1$s 或更高版本。你当前使用的 "
"WordPress 版本为 %2$s。"

#: linger-ai-bridge-for-openai-compatible-apis.php:94
msgid ""
"The AI Bridge for OpenAI-Compatible APIs plugin requires the WordPress AI "
"Client to be available in WordPress 7.0+."
msgstr ""
"AI Bridge for OpenAI-Compatible APIs 插件需要 WordPress 7.0 或更高版本中提供的 WordPress "
"AI Client。"

#: src/Plugin.php:137
msgid "Settings"
msgstr "设置"

#: src/Provider/ResponsesProvider.php:39
msgid ""
"Configurable Responses and Chat Completions compatible text generation "
"provider."
msgstr "可配置的文本生成服务提供商，兼容 Responses 和 Chat Completions 接口。"

#: src/Settings/ResponsesSettings.php:56
msgid "API Base URL"
msgstr "API 基础 URL"

#: src/Settings/ResponsesSettings.php:64
msgid "Models"
msgstr "模型"

#: src/Settings/ResponsesSettings.php:106
msgid "Duplicate model IDs were ignored. Use a unique ID for each model."
msgstr "已忽略重复的模型 ID。请为每个模型使用唯一的 ID。"

#: src/Settings/ResponsesSettings.php:110
msgid "Only the first 10 models were saved."
msgstr "仅保存了前 10 个模型。"

#: src/Settings/ResponsesSettings.php:166
msgid ""
"Enter an HTTP or HTTPS base URL without credentials, a query string, or a "
"fragment."
msgstr "请输入 HTTP 或 HTTPS 基础 URL，不要包含用户名、密码、查询参数或片段标识。"

#: src/Settings/ResponsesSettings.php:179
msgid ""
"Configure a shared API base URL and multiple models. Each model can choose "
"either /v1/responses or /v1/chat/completions."
msgstr ""
"配置共用的 API 基础 URL 和多个模型。每个模型均可选择 /v1/responses 或 /v1/chat/completions 接口。"

#. translators: 1: Opening link tag for the Connectors settings screen, 2:
#. Closing link tag.
#: src/Settings/ResponsesSettings.php:184
#, php-format
msgid ""
"Set your API key under %1$sSettings > Connectors%2$s for the AI Bridge for "
"OpenAI-Compatible APIs connector."
msgstr ""
"请在%1$s设置 > Connectors%2$s 中，为 AI Bridge for OpenAI-Compatible APIs 连接器配置 API"
" 密钥。"

#: src/Settings/ResponsesSettings.php:205
msgid ""
"Enter the base URL for your OpenAI-compatible service, including its API "
"version path when required."
msgstr "请输入 OpenAI 兼容服务的基础 URL；如服务有要求，请包含 API 版本路径。"

#: src/Settings/ResponsesSettings.php:217
msgid "Default"
msgstr "默认"

#: src/Settings/ResponsesSettings.php:218
msgid "Enabled"
msgstr "启用"

#: src/Settings/ResponsesSettings.php:219
#: src/Settings/ResponsesSettings.php:257
msgid "Model ID"
msgstr "模型 ID"

#: src/Settings/ResponsesSettings.php:220
msgid "Label"
msgstr "显示名称"

#: src/Settings/ResponsesSettings.php:221
msgid "Endpoint Type"
msgstr "接口协议"

#: src/Settings/ResponsesSettings.php:222
msgid "Streaming"
msgstr "流式响应"

#: src/Settings/ResponsesSettings.php:223
msgid "Actions"
msgstr "操作"

#: src/Settings/ResponsesSettings.php:227
msgid ""
"Add up to 10 models. Enable the models you want to use and select a default."
" The default is preferred for automatic text generation in the WordPress AI "
"plugin; explicit model selections take precedence."
msgstr ""
"最多可添加 10 个模型。启用需要使用的模型，并选择默认模型。WordPress AI 插件的自动文本生成会优先使用默认模型；明确指定的模型仍优先生效。"

#: src/Settings/ResponsesSettings.php:242
msgid "Add model"
msgstr "添加模型"

#: src/Settings/ResponsesSettings.php:243
msgid "The maximum of 10 models has been reached."
msgstr "已达到 10 个模型的数量上限。"

#: src/Settings/ResponsesSettings.php:245
msgid "Enable JavaScript to add or remove models."
msgstr "请启用 JavaScript 以添加或删除模型。"

#: src/Settings/ResponsesSettings.php:255
msgid "Use as default model"
msgstr "设为默认模型"

#: src/Settings/ResponsesSettings.php:256
msgid "Enable model"
msgstr "启用模型"

#: src/Settings/ResponsesSettings.php:258
msgid "Model label"
msgstr "模型显示名称"

#: src/Settings/ResponsesSettings.php:259
msgid "Endpoint type"
msgstr "接口协议"

#: src/Settings/ResponsesSettings.php:263
msgid "Use a streaming response (Responses only)"
msgstr "使用流式响应（仅限 Responses）"

#: src/Settings/ResponsesSettings.php:264
msgid "Remove"
msgstr "删除"
